+
+fn ui_selected_style() -> Style {
+    Style::default().fg(UI_BG).bg(UI_GREEN).bold()
+}
+
+fn ui_row_style(index: usize) -> Style {
+    Style::default().fg(UI_TEXT).bg(if index.is_multiple_of(2) {
+        UI_PANEL
+    } else {
+        UI_PANEL_ALT
+    })
+}
+
+fn model_state_style(state: &str) -> Style {
+    let state = state.to_ascii_lowercase();
+    let color = if state.contains("load") || state.contains("ready") || state.contains("active") {
+        UI_GREEN
+    } else if state.contains("fail") || state.contains("error") || state.contains("unavailable") {
+        UI_RED
+    } else if state.contains("start") || state.contains("pending") {
+        UI_AMBER
+    } else {
+        UI_MUTED
+    };
+    Style::default().fg(color)
+}
+
+fn boolean_state_style(enabled: bool) -> Style {
+    Style::default().fg(if enabled { UI_GREEN } else { UI_MUTED })
+}
+
+fn job_state_style(state: &str) -> Style {
+    let state = state.to_ascii_lowercase();
+    let color = if state.contains("run") || state.contains("complete") || state.contains("success")
+    {
+        UI_GREEN
+    } else if state.contains("fail") || state.contains("error") {
+        UI_RED
+    } else if state.contains("stop") || state.contains("cancel") {
+        UI_AMBER
+    } else {
+        UI_MUTED
+    };
+    Style::default().fg(color)
+}
