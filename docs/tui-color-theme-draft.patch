+fn ui_panel<'a>() -> Block<'a> {
+    Block::default()
+        .borders(Borders::ALL)
+        .style(Style::default().fg(UI_TEXT).bg(UI_PANEL))
+        .border_style(ui_border_style())
+        .title_style(Style::default().fg(UI_AMBER).bg(UI_PANEL).bold())
+}
+
+fn ui_popup<'a>() -> Block<'a> {
+    ui_panel()
+        .border_style(ui_active_border_style())
+        .title_style(Style::default().fg(UI_GREEN).bg(UI_PANEL).bold())
+}
+
+fn ui_border_style() -> Style {
+    Style::default().fg(UI_BORDER).bg(UI_PANEL)
+}
+
+fn ui_active_border_style() -> Style {
+    Style::default().fg(UI_GREEN).bg(UI_PANEL)
+}
+
+fn ui_label_style() -> Style {
+    Style::default().fg(UI_MUTED).bold()
